#!/bin/sh

# Fills a local registry on 127.0.0.1:5000 with a varied catalog for manual testing.
# Uses only public, vendor-neutral images.

for i in alpine chronograf:alpine consul debian jawg/mapnik3 nginx:alpine postgres:alpine redis:alpine telegraf:alpine; do
  docker pull $i
  docker tag $i 127.0.0.1:5000/$i
  docker push 127.0.0.1:5000/$i
done

# A namespaced repository with many tags, to exercise catalog branching and the tag list.
for v in 3.18 3.19 3.20 3.21 3.22 latest; do
  docker pull alpine:$v
  docker tag alpine:$v 127.0.0.1:5000/yorch/docker-registry-ui:$v
  docker push 127.0.0.1:5000/yorch/docker-registry-ui:$v
done
