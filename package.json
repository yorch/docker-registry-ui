{
  "name": "docker-registry-ui",
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "vite",
    "build": "vite build",
    "build:site": "node site/build.mjs",
    "build:electron": "npm run build && cd examples/electron && npm install && npm run dist",
    "test": "mocha",
    "test:e2e": "mocha --config .mocharc.e2e.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yorch/docker-registry-ui.git"
  },
  "author": "Jorge Barnaby (yorch)",
  "license": "AGPL-3.0",
  "description": "A web UI for private docker registry",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@riotjs/compiler": "9.4.9",
    "@riotjs/observable": "4.1.1",
    "@riotjs/route": "9.2.2",
    "jsdom": "30.1.2",
    "marked": "18.1.1",
    "mocha": "12.0.3",
    "playwright": "1.64.1",
    "riot": "9.4.11",
    "sass": "1.105.1",
    "vite": "8.3.4"
  }
}
