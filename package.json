{
  "name": "docker-registry-ui",
  "version": "3.2.1",
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "rollup -c -w --environment ROLLUP_SERVE:true",
    "build": "rollup -c",
    "build:site": "node site/build.mjs",
    "build:electron": "npm run build && cd examples/electron && npm install && npm run dist",
    "test": "mocha",
    "test:e2e": "mocha --config .mocharc.e2e.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yorch/docker-registry-ui.git"
  },
  "author": "Jorge Barnaby (yorch)",
  "license": "AGPL-3.0",
  "description": "A web UI for private docker registry",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "@biomejs/biome": "2.5.7",
    "@riotjs/compiler": "^9.4.1",
    "@riotjs/observable": "^4.1.1",
    "@riotjs/route": "^9.2.1",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "core-js": "^3.27.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "mocha": "^11.2.0",
    "playwright": "^1.62.1",
    "riot": "^9.4.4",
    "rollup": "^4.30.1",
    "rollup-plugin-app-utils": "^1.0.6",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-riot": "^9.0.2",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "sass": "^1.86.2"
  }
}
