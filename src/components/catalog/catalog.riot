<catalog>
  <div class="panel catalog-header" aria-busy="{ !state.loadend || state.refreshing ? 'true' : 'false' }">
    <div class="panel-header">
      <div class="catalog-title">
        <h2 class="panel-title">Repositories</h2>
        <label class="tagless-toggle" if="{ props.showCatalogNbTags }">
          <app-checkbox
            checked="{ state.showTagless }"
            on-change="{ onToggleTagless }"
            aria-label="Show repositories without tags"
          ></app-checkbox>
          <span>Show repositories without tags</span>
        </label>
      </div>
      <div class="catalog-stats">
        <span
          if="{ state.loadend }"
          class="badge badge--accent"
          title="Names you can pull, as returned by the registry's catalog — for example team/service-a."
          >{ state.nRepositories } repositories</span
        >
        <span
          if="{ state.loadend }"
          class="badge badge--neutral"
          title="Top-level rows below: repositories sharing a leading path segment are grouped under it, for example team/. A display grouping only — the registry does not store namespaces."
          >{ state.nNamespaces } namespaces</span
        >
        <button
          class="btn btn--sm"
          onclick="{ refresh }"
          disabled="{ !state.loadend || state.refreshing }"
          aria-label="Refresh repositories"
          type="button"
        >
          <i class="material-icons" aria-hidden="true">refresh</i>
          { state.refreshing ? 'Refreshing…' : 'Refresh' }
        </button>
      </div>
    </div>
  </div>

  <registry-operations
    if="{ state.loadend }"
    registry-url="{ props.registryUrl }"
    catalog-elements-limit="{ state.catalogElementsLimit }"
    on-notify="{ props.onNotify }"
    on-authentication="{ props.onAuthentication }"
    is-registry-secured="{ props.isRegistrySecured }"
    is-image-remove-activated="{ props.isImageRemoveActivated }"
    on-registry-changed="{ refresh }"
  ></registry-operations>

  <div class="panel" if="{ !state.loadend }" role="status" aria-label="Loading repositories">
    <div class="skeleton-row" each="{ i in skeletonRows }">
      <span aria-hidden="true" class="skeleton skeleton-icon"></span>
      <span aria-hidden="true" class="skeleton skeleton-line { i % 3 === 0 ? 'wide' : '' }"></span>
    </div>
    <span class="sr-only">Loading repositories…</span>
  </div>

  <p if="{ state.refreshing }" class="refresh-status" role="status">Refreshing repository data…</p>

  <p if="{ state.loadend && hasPendingTagCounts() && !hasVisibleRepositories() }" class="refresh-status" role="status">
    Checking repositories for tags…
  </p>

  <div if="{ state.loadend && !hasPendingTagCounts() && !hasVisibleRepositories() }" class="empty-state">
    <span class="empty-icon"><i class="material-icons" aria-hidden="true">{ props.filterResults ? 'search_off' : 'inbox' }</i></span>
    <h3>{ props.filterResults ? 'No matching repositories' : state.tree.length ? 'No tagged repositories' : 'No repositories' }</h3>
    <p if="{ props.filterResults }">No repository matches “{ props.filterResults }”.</p>
    <p if="{ !props.filterResults && state.tree.length === 0 }">This registry has no repositories yet. Push your first image to get started.</p>
    <p if="{ !props.filterResults && state.tree.length > 0 }">Every repository is currently tagless.</p>
    <button if="{ props.filterResults }" class="btn" onclick="{ props.onClearSearch }" type="button">Clear Search</button>
    <button if="{ !props.filterResults && state.tree.length > 0 }" class="btn" onclick="{ showAllRepositories }" type="button">Show All Repositories</button>
  </div>

  <div class="list-group" if="{ state.loadend && hasVisibleRepositories() }">
    <catalog-element
      each="{ item in state.tree }"
      item="{ item }"
      filter-results="{ props.filterResults }"
      registry-url="{ props.registryUrl }"
      on-notify="{ props.onNotify }"
      on-authentication="{ props.onAuthentication }"
      show-catalog-nb-tags="{ props.showCatalogNbTags }"
      show-tagless="{ state.showTagless }"
      counts="{ state.counts }"
      catalog-default-expanded="{ props.catalogDefaultExpanded || state.nNamespaces === 1 }"
      is-registry-secured="{ props.isRegistrySecured }"
    ></catalog-element>
  </div>

  <div class="catalog-pagination" if="{ state.loadend && state.nextCatalogUrl }">
    <p>
      { state.repositoryNames.length } repositories loaded. More are available from the registry.
    </p>
    <div class="catalog-pagination-actions">
      <button class="btn btn--primary" onclick="{ () => loadNextPage(false) }" disabled="{ state.loadingMore }" type="button">
        { state.loadingMore ? 'Loading…' : 'Load More' }
      </button>
      <button class="btn" onclick="{ () => loadNextPage(true) }" disabled="{ state.loadingMore }" type="button">
        Load All
      </button>
    </div>
  </div>

  <script>
    import CatalogElement from './catalog-element.riot';
    import RegistryOperations from './registry-operations.riot';
    import { Http } from '../../scripts/http';
    import { requestPool } from '../../scripts/request-pool';
    import { invalidateRegistry } from '../../scripts/cache-request';
    import { getBranching } from '../../scripts/repositories';
    import { matchSearch } from '../search-bar.riot';
    import { parseNextLink, RegistryClient } from '../../scripts/registry-client';

    const SHOW_TAGLESS_KEY = 'registryUiShowTagless';

    // Tag counts arrive one response at a time. Flushing them on a short
    // interval bounds the number of full-catalog re-renders instead of doing
    // one per repository, which is O(N^2) work on a large registry.
    const COUNTS_FLUSH_MS = 100;

    // Flatten the namespace tree back to the repository names it groups.
    const collectRepositories = (items, out = []) => {
      items.forEach((item) => {
        if (typeof item === 'string') {
          out.push(item);
        } else if (item.repositories) {
          collectRepositories(item.repositories, out);
        }
      });
      return out;
    };

    export default {
      components: {
        CatalogElement,
        RegistryOperations,
      },
      skeletonRows: [0, 1, 2, 3, 4, 5],
      state: {
        length: 0,
        loadend: false,
        tree: [],
        repositoryNames: [],
        registryUrl: '',
        counts: {},
        showTagless: true,
      },

      onBeforeMount(props) {
        this.state.catalogElementsLimit = props.catalogElementsLimit;
        this.state.showTagless = localStorage.getItem(SHOW_TAGLESS_KEY) !== 'false';
        try {
          this.state.branching = getBranching(props.catalogMinBranches, props.catalogMaxBranches);
        } catch (e) {
          props.onNotify(e);
        }
      },
      onMounted(props, state) {
        this.display(props, state);
      },
      onUpdated(props, state) {
        this.display(props, state);
      },
      onToggleTagless(event) {
        const showTagless = event.target.checked;
        localStorage.setItem(SHOW_TAGLESS_KEY, String(showTagless));
        this.update({ showTagless });
      },
      showAllRepositories() {
        localStorage.setItem(SHOW_TAGLESS_KEY, 'true');
        this.update({ showTagless: true });
      },
      hasVisibleRepositories() {
        if (!this.state.tree.length) return false;
        return collectRepositories(this.state.tree).some((repository) => {
          if (!matchSearch(this.props.filterResults, repository)) return false;
          if (!this.props.showCatalogNbTags || this.state.showTagless) return true;
          const count = this.state.counts[repository];
          return count === null || count > 0;
        });
      },
      hasPendingTagCounts() {
        if (!this.props.showCatalogNbTags || this.state.showTagless) return false;
        return collectRepositories(this.state.tree).some((repository) => this.state.counts[repository] === undefined);
      },
      onBeforeUnmount() {
        this.activeRequest?.abort();
        this.requestGeneration = (this.requestGeneration || 0) + 1;
        this.cancelPendingCounts();
      },
      cancelPendingCounts() {
        if (this.countsTimer) {
          clearTimeout(this.countsTimer);
          this.countsTimer = null;
        }
        this.pendingCounts = null;
      },
      // Accumulate counts and render them in batches. `null` means the count
      // could not be fetched, `undefined` means it is still in flight.
      queueCount(repository, count, registryUrl) {
        if (registryUrl !== this.state.registryUrl) {
          return;
        }
        this.pendingCounts = this.pendingCounts || {};
        this.pendingCounts[repository] = count;
        if (this.countsTimer) {
          return;
        }
        this.countsTimer = setTimeout(() => {
          this.countsTimer = null;
          const pending = this.pendingCounts;
          this.pendingCounts = null;
          if (pending && registryUrl === this.state.registryUrl) {
            this.update({ counts: { ...this.state.counts, ...pending } });
          }
        }, COUNTS_FLUSH_MS);
      },
      fetchNbTags(repository, props, noCache = false) {
        return new Promise((resolve) => {
          requestPool.submit((done) => {
            const oReq = new Http({
              onAuthentication: props.onAuthentication,
              withCredentials: props.isRegistrySecured,
              noCache,
            });
            oReq.addEventListener('loadend', function () {
              // Free the slot before doing anything with the response: parsing
              // it must not decide whether the next request ever starts.
              done();
              if (this.status === 200) {
                resolve({ count: (JSON.parse(this.responseText).tags || []).length });
              } else if (this.status === 404) {
                resolve({ error: 'Server not found' });
              } else {
                resolve({ error: this.responseText });
              }
            });
            oReq.addEventListener('error', function () {
              resolve({ error: this.getErrorMessage() });
            });
            oReq.open('GET', props.registryUrl + '/v2/' + repository + '/tags/list');
            oReq.send();
          });
        });
      },
      fetchCounts(images, props, noCache = false) {
        if (!props.showCatalogNbTags || !images.length) return;
        const registryUrl = props.registryUrl;
        let notified = false;
        images.forEach((repository) => {
          this.fetchNbTags(repository, props, noCache).then(({ count, error }) => {
            if (error !== undefined) {
              if (!notified) {
                notified = true;
                this.props.onNotify(error, true);
              }
              return this.queueCount(repository, null, registryUrl);
            }
            this.queueCount(repository, count, registryUrl);
          });
        });
      },
      groupByNamespace(repositoryNames) {
        const names = [...new Set(repositoryNames)].sort();
        return typeof this.state.branching === 'function' ? this.state.branching(names) : names;
      },
      async loadNextPage(loadAll) {
        if (!this.state.nextCatalogUrl || this.state.loadingMore) return;
        const generation = this.requestGeneration;
        const client = new RegistryClient({
          registryUrl: this.props.registryUrl,
          onAuthentication: this.props.onAuthentication,
          isRegistrySecured: this.props.isRegistrySecured,
        });
        this.update({ loadingMore: true });
        try {
          let next = this.state.nextCatalogUrl;
          const names = [...this.state.repositoryNames];
          const knownNames = new Set(names);
          const added = [];
          do {
            const page = await client.catalogPage({ url: next, visited: this.visitedCatalogUrls });
            if (generation !== this.requestGeneration) return;
            page.repositories.forEach((name) => {
              if (!knownNames.has(name)) {
                knownNames.add(name);
                names.push(name);
                added.push(name);
              }
            });
            next = page.next;
            // nRepositories counts pullable names; nNamespaces counts what the
            // tree actually shows at its top level. Reporting the flat length
            // for both made the two badges always agree and broke the
            // single-namespace auto-expand below.
            const displayed = this.groupByNamespace(names);
            this.update({
              repositoryNames: names,
              tree: displayed,
              nRepositories: names.length,
              nNamespaces: displayed.length,
              nextCatalogUrl: next,
            });
            // Counts are fetched per page rather than after the whole run: a
            // later page failing used to leave every repository already merged
            // into the tree stuck on the pending badge forever, and hidden
            // outright when "show tagless" was off.
            this.fetchCounts(added.splice(0), this.props);
          } while (loadAll && next);
        } catch (error) {
          if (generation === this.requestGeneration) this.props.onNotify(error.message || error, true);
        } finally {
          // Unconditional: a registry switch mid-page bumps the generation, and
          // gating this on it left the flag stuck true, disabling Load More /
          // Load All for the rest of the session on the registry switched to.
          this.update({ loadingMore: false });
        }
      },
      refresh() {
        this.display(this.props, this.state, true);
      },
      display(props, state, refresh = false) {
        if (!refresh && props.registryUrl === state.registryUrl) {
          return;
        }
        const generation = (this.requestGeneration || 0) + 1;
        this.requestGeneration = generation;
        this.activeRequest?.abort();
        state.registryUrl = props.registryUrl;
        if (refresh) {
          invalidateRegistry(props.registryUrl);
          this.update({ refreshing: true });
        } else {
          this.update({ loadend: false, tree: [], repositoryNames: [], counts: {}, refreshing: false });
        }
        // Loading a different registry supersedes whatever page-level error the
        // previous one produced.
        if (props.onClearPageError) {
          props.onClearPageError();
        }
        this.cancelPendingCounts();
        // Counts queued for the registry we are leaving are worthless now, and
        // they would otherwise be served ahead of this registry's own.
        requestPool.drop();
        let tree = [];
        let repositoryNames = [];
        let nextCatalogUrl;
        let nRepositories = 0;
        const self = this;
        const catalogUrl = `${props.registryUrl}/v2/_catalog?n=${state.catalogElementsLimit}`;
        // Loop guard for the continuation links followed by loadNextPage. Seeded
        // with the first page so a registry that advertises a next page pointing
        // back at it stops here rather than paging forever.
        this.visitedCatalogUrls = new Set([catalogUrl]);
        const oReq = new Http({
          onAuthentication: this.props.onAuthentication,
          withCredentials: props.isRegistrySecured,
        });
        oReq.addEventListener('load', function () {
          if (generation !== self.requestGeneration) return;
          if (this.status === 200) {
            repositoryNames = (JSON.parse(this.responseText).repositories || []).sort();
            tree = self.groupByNamespace(repositoryNames);
            nRepositories = repositoryNames.length;
            nextCatalogUrl = parseNextLink(this.getResponseHeader('Link'), catalogUrl);
          } else if (this.status === 404) {
            self.props.onNotify({ code: 'CATALOG_NOT_FOUND', url: catalogUrl }, true);
          } else if (this.status === 400) {
            let response;
            try {
              response = JSON.parse(this.responseText);
            } catch (e) {}
            if (!response || !Array.isArray(response.errors)) {
              return self.props.onNotify(this.responseText, true);
            }
            self.props.onNotify({ ...response, url: catalogUrl }, true);
          } else {
            self.props.onNotify(this.responseText);
          }
        });
        oReq.addEventListener('error', function () {
          if (generation !== self.requestGeneration) return;
          self.props.onNotify(this.getErrorMessage(), true);
        });
        oReq.addEventListener('loadend', function () {
          if (generation !== self.requestGeneration) return;
          // Render the list immediately; tag counts are fetched in the
          // background and the badges fill in as each count arrives.
          self.update({
            tree,
            repositoryNames,
            // The branched top-level count, not the flat one -- see loadNextPage.
            nNamespaces: tree.length,
            nRepositories,
            nextCatalogUrl,
            counts: {},
            loadend: true,
            refreshing: false,
          });
          self.fetchCounts(repositoryNames, props, refresh);
        });
        oReq.open('GET', catalogUrl);
        this.activeRequest = oReq;
        oReq.send();
      },
    };
  </script>
  <style>
    :host {
      display: block;
    }

    :host .catalog-header {
      margin-bottom: var(--space-4);
    }

    :host .catalog-stats {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    :host .catalog-title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }

    :host .tagless-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--fs-md);
      color: var(--text-secondary);
      cursor: pointer;
      user-select: none;
    }

    :host .list-group {
      animation: fade-in-up var(--dur-normal) var(--ease-out);
    }

    :host .catalog-pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-top: var(--space-4);
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--surface);
      color: var(--text-secondary);
    }

    :host .catalog-pagination p {
      margin: 0;
    }

    :host .catalog-pagination-actions {
      display: flex;
      gap: var(--space-2);
    }

    @media screen and (max-width: 600px) {
      :host .catalog-pagination {
        align-items: stretch;
        flex-direction: column;
      }
    }
  </style>
</catalog>
