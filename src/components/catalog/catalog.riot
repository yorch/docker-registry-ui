<catalog>
  <div class="panel catalog-header" aria-busy="{ !state.loadend || state.refreshing ? 'true' : 'false' }">
    <div class="panel-header">
      <div class="catalog-title">
        <h2 class="panel-title">
          Repositories
          <span class="panel-subtitle">of { state.registryName }</span>
        </h2>
        <label class="tagless-toggle" if="{ props.showCatalogNbTags }">
          <app-checkbox
            checked="{ state.showTagless }"
            on-change="{ onToggleTagless }"
            aria-label="Show images without tags"
          ></app-checkbox>
          <span>Show images without tags</span>
        </label>
      </div>
      <div class="catalog-stats">
        <span if="{ state.loadend }" class="badge badge--accent">{ state.nImages } images</span>
        <span if="{ state.loadend }" class="badge badge--neutral">{ state.nRepositories } repositories</span>
        <button
          class="btn btn--sm"
          onclick="{ refresh }"
          disabled="{ !state.loadend || state.refreshing }"
          aria-label="Refresh repositories"
          type="button"
        >
          <i class="material-icons" aria-hidden="true">refresh</i>
          { state.refreshing ? 'Refreshing…' : 'Refresh' }
        </button>
      </div>
    </div>
  </div>

  <div class="panel" if="{ !state.loadend }" role="status" aria-label="Loading repositories">
    <div class="skeleton-row" each="{ i in skeletonRows }">
      <span aria-hidden="true" class="skeleton skeleton-icon"></span>
      <span aria-hidden="true" class="skeleton skeleton-line { i % 3 === 0 ? 'wide' : '' }"></span>
    </div>
    <span class="sr-only">Loading repositories…</span>
  </div>

  <p if="{ state.refreshing }" class="refresh-status" role="status">Refreshing repository data…</p>

  <p if="{ state.loadend && hasPendingTagCounts() && !hasVisibleRepositories() }" class="refresh-status" role="status">
    Checking repositories for tags…
  </p>

  <div if="{ state.loadend && !hasPendingTagCounts() && !hasVisibleRepositories() }" class="empty-state">
    <span class="empty-icon"><i class="material-icons" aria-hidden="true">{ props.filterResults ? 'search_off' : 'inbox' }</i></span>
    <h3>{ props.filterResults ? 'No matching repositories' : state.repositories.length ? 'No tagged repositories' : 'No repositories' }</h3>
    <p if="{ props.filterResults }">No repository matches “{ props.filterResults }”.</p>
    <p if="{ !props.filterResults && state.repositories.length === 0 }">This registry has no repositories yet. Push your first image to get started.</p>
    <p if="{ !props.filterResults && state.repositories.length > 0 }">Every repository is currently tagless.</p>
    <button if="{ props.filterResults }" class="btn" onclick="{ props.onClearSearch }" type="button">Clear Search</button>
    <button if="{ !props.filterResults && state.repositories.length > 0 }" class="btn" onclick="{ showAllImages }" type="button">Show All Images</button>
  </div>

  <div class="list-group" if="{ state.loadend && hasVisibleRepositories() }">
    <catalog-element
      each="{ item in state.repositories }"
      item="{ item }"
      filter-results="{ props.filterResults }"
      registry-url="{ props.registryUrl }"
      on-notify="{ props.onNotify }"
      on-authentication="{ props.onAuthentication }"
      show-catalog-nb-tags="{ props.showCatalogNbTags }"
      show-tagless="{ state.showTagless }"
      counts="{ state.counts }"
      catalog-default-expanded="{ props.catalogDefaultExpanded || state.nRepositories === 1 }"
      is-registry-secured="{ props.isRegistrySecured }"
    ></catalog-element>
  </div>

  <script>
    import CatalogElement from './catalog-element.riot';
    import { Http } from '../../scripts/http';
    import { requestPool } from '../../scripts/request-pool';
    import { invalidateRegistry } from '../../scripts/cache-request';
    import { getBranching } from '../../scripts/repositories';
    import { getRegistryServers } from '../../scripts/utils';
    import { matchSearch } from '../search-bar.riot';

    const SHOW_TAGLESS_KEY = 'registryUiShowTagless';

    // Tag counts arrive one response at a time. Flushing them on a short
    // interval bounds the number of full-catalog re-renders instead of doing
    // one per repository, which is O(N^2) work on a large registry.
    const COUNTS_FLUSH_MS = 100;

    // Collect every leaf image name from the branched repository tree.
    const collectImages = (items, out = []) => {
      items.forEach((item) => {
        if (typeof item === 'string') {
          out.push(item);
        } else if (item.images) {
          collectImages(item.images, out);
        }
      });
      return out;
    };

    export default {
      components: {
        CatalogElement,
      },
      skeletonRows: [0, 1, 2, 3, 4, 5],
      state: {
        registryName: '',
        length: 0,
        loadend: false,
        repositories: [],
        registryUrl: '',
        counts: {},
        showTagless: true,
      },

      onBeforeMount(props) {
        this.state.registryName = props.registryName;
        this.state.catalogElementsLimit = props.catalogElementsLimit;
        this.state.showTagless = localStorage.getItem(SHOW_TAGLESS_KEY) !== 'false';
        try {
          this.state.branching = getBranching(props.catalogMinBranches, props.catalogMaxBranches);
        } catch (e) {
          props.onNotify(e);
        }
      },
      onMounted(props, state) {
        this.display(props, state);
      },
      onUpdated(props, state) {
        this.display(props, state);
      },
      onToggleTagless(event) {
        const showTagless = event.target.checked;
        localStorage.setItem(SHOW_TAGLESS_KEY, String(showTagless));
        this.update({ showTagless });
      },
      showAllImages() {
        localStorage.setItem(SHOW_TAGLESS_KEY, 'true');
        this.update({ showTagless: true });
      },
      hasVisibleRepositories() {
        if (!this.state.repositories.length) return false;
        return collectImages(this.state.repositories).some((image) => {
          if (!matchSearch(this.props.filterResults, image)) return false;
          if (!this.props.showCatalogNbTags || this.state.showTagless) return true;
          const count = this.state.counts[image];
          return count === null || count > 0;
        });
      },
      hasPendingTagCounts() {
        if (!this.props.showCatalogNbTags || this.state.showTagless) return false;
        return collectImages(this.state.repositories).some((image) => this.state.counts[image] === undefined);
      },
      onBeforeUnmount() {
        this.activeRequest?.abort();
        this.requestGeneration = (this.requestGeneration || 0) + 1;
        this.cancelPendingCounts();
      },
      cancelPendingCounts() {
        if (this.countsTimer) {
          clearTimeout(this.countsTimer);
          this.countsTimer = null;
        }
        this.pendingCounts = null;
      },
      // Accumulate counts and render them in batches. `null` means the count
      // could not be fetched, `undefined` means it is still in flight.
      queueCount(image, count, registryUrl) {
        if (registryUrl !== this.state.registryUrl) {
          return;
        }
        this.pendingCounts = this.pendingCounts || {};
        this.pendingCounts[image] = count;
        if (this.countsTimer) {
          return;
        }
        this.countsTimer = setTimeout(() => {
          this.countsTimer = null;
          const pending = this.pendingCounts;
          this.pendingCounts = null;
          if (pending && registryUrl === this.state.registryUrl) {
            this.update({ counts: { ...this.state.counts, ...pending } });
          }
        }, COUNTS_FLUSH_MS);
      },
      fetchNbTags(image, props, noCache = false) {
        return new Promise((resolve) => {
          requestPool.submit((done) => {
            const oReq = new Http({
              onAuthentication: props.onAuthentication,
              withCredentials: props.isRegistrySecured,
              noCache,
            });
            oReq.addEventListener('loadend', function () {
              // Free the slot before doing anything with the response: parsing
              // it must not decide whether the next request ever starts.
              done();
              if (this.status === 200) {
                resolve({ count: (JSON.parse(this.responseText).tags || []).length });
              } else if (this.status === 404) {
                resolve({ error: 'Server not found' });
              } else {
                resolve({ error: this.responseText });
              }
            });
            oReq.addEventListener('error', function () {
              resolve({ error: this.getErrorMessage() });
            });
            oReq.open('GET', props.registryUrl + '/v2/' + image + '/tags/list');
            oReq.send();
          });
        });
      },
      refresh() {
        this.display(this.props, this.state, true);
      },
      display(props, state, refresh = false) {
        if (!refresh && props.registryUrl === state.registryUrl) {
          return;
        }
        const generation = (this.requestGeneration || 0) + 1;
        this.requestGeneration = generation;
        this.activeRequest?.abort();
        state.registryUrl = props.registryUrl;
        if (refresh) {
          invalidateRegistry(props.registryUrl);
          this.update({ refreshing: true });
        } else {
          this.update({ loadend: false, repositories: [], counts: {}, refreshing: false });
        }
        // Loading a different registry supersedes whatever page-level error the
        // previous one produced.
        if (props.onClearPageError) {
          props.onClearPageError();
        }
        this.cancelPendingCounts();
        // Counts queued for the registry we are leaving are worthless now, and
        // they would otherwise be served ahead of this registry's own.
        requestPool.drop();
        let repositories = [];
        let nImages = 0;
        const self = this;
        const catalogUrl = `${props.registryUrl}/v2/_catalog?n=${state.catalogElementsLimit}`;
        const oReq = new Http({
          onAuthentication: this.props.onAuthentication,
          withCredentials: props.isRegistrySecured,
        });
        oReq.addEventListener('load', function () {
          if (generation !== self.requestGeneration) return;
          if (this.status === 200) {
            repositories = JSON.parse(this.responseText).repositories || [];
            repositories.sort();
            nImages = repositories.length;
            if (typeof state.branching === 'function') {
              repositories = state.branching(repositories);
            }
          } else if (this.status === 404) {
            self.props.onNotify({ code: 'CATALOG_NOT_FOUND', url: catalogUrl }, true);
          } else if (this.status === 400) {
            let response;
            try {
              response = JSON.parse(this.responseText);
            } catch (e) {}
            if (!response || !Array.isArray(response.errors)) {
              return self.props.onNotify(this.responseText, true);
            }
            self.props.onNotify({ ...response, url: catalogUrl }, true);
          } else {
            self.props.onNotify(this.responseText);
          }
        });
        oReq.addEventListener('error', function () {
          if (generation !== self.requestGeneration) return;
          self.props.onNotify(this.getErrorMessage(), true);
        });
        oReq.addEventListener('loadend', function () {
          if (generation !== self.requestGeneration) return;
          // Render the list immediately; tag counts are fetched in the
          // background and the badges fill in as each count arrives.
          self.update({
            repositories,
            nRepositories: repositories.length,
            nImages,
            counts: {},
            loadend: true,
            refreshing: false,
          });
          if (props.showCatalogNbTags && repositories.length > 0) {
            const registryUrl = props.registryUrl;
            // A registry that rejects `/tags/list` rejects it for every
            // repository; report the reason once instead of N times.
            let notified = false;
            collectImages(repositories).forEach((image) => {
              self.fetchNbTags(image, props, refresh).then(({ count, error }) => {
                if (error !== undefined) {
                  if (!notified) {
                    notified = true;
                    self.props.onNotify(error, true);
                  }
                  return self.queueCount(image, null, registryUrl);
                }
                self.queueCount(image, count, registryUrl);
              });
            });
          }
        });
        oReq.open('GET', catalogUrl);
        this.activeRequest = oReq;
        oReq.send();
      },
    };
  </script>
  <style>
    :host {
      display: block;
    }

    :host .catalog-header {
      margin-bottom: var(--space-4);
    }

    :host .catalog-stats {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    :host .catalog-title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }

    :host .tagless-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--fs-md);
      color: var(--text-secondary);
      cursor: pointer;
      user-select: none;
    }

    :host .list-group {
      animation: fade-in-up var(--dur-normal) var(--ease-out);
    }
  </style>
</catalog>
