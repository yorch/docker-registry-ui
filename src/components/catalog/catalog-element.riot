<catalog-element>
  <div
    class="content"
    if="{!props.filterResults || state.nRepositories > 0 || matchSearch(props.filterResults, state.repository)}"
  >
    <div class="tree-node { state.expanded ? 'expanded' : '' }">
      <div
        class="list-row { state.repositories ? 'is-group' : 'is-leaf' }"
        if="{ isRowVisible(props, state) }"
      >
        <a if="{ state.repository }" class="row-main" href="{ router.taglist(state.repository) }">
          <i class="material-icons row-icon">send</i>
          <span class="row-label">{ state.repository }</span>
        </a>
        <button
          if="{ state.repositories }"
          class="row-main"
          aria-expanded="{ state.expanded }"
          onclick="{ onClick }"
          type="button"
        >
          <i class="material-icons row-icon">folder</i>
          <span class="row-label">{ state.namespace }</span>
        </button>
        <span class="row-meta">
          <span if="{ state.repositories }" class="badge" title="{ state.nRepositories } repositories">{ state.nRepositories }</span>
          <span
            if="{ props.showCatalogNbTags && state.repository }"
            class="badge badge--accent { typeof state.nbTags === 'number' ? '' : 'is-pending' }"
            title="{ nbTagsTitle(state.nbTags) }"
          >
            <i class="material-icons badge-icon">sell</i>
            { nbTagsLabel(state.nbTags) }
          </span>
          <i if="{ state.repositories }" class="material-icons row-chevron { state.expanded ? 'expanded' : '' }">
            expand_more
          </i>
        </span>
      </div>
      <div class="tree-children { !state.expanded && !props.filterResults ? 'collapsed' : '' }">
        <catalog-element
          filter-results="{ props.filterResults }"
          registry-url="{ props.registryUrl }"
          on-notify="{ props.onNotify }"
          on-authentication="{ props.onAuthentication }"
          show-catalog-nb-tags="{ props.showCatalogNbTags }"
          show-tagless="{ props.showTagless }"
          counts="{ props.counts }"
          catalog-default-expanded="{ props.catalogDefaultExpanded }"
          is-registry-secured="{ props.isRegistrySecured }"
          each="{ item in state.repositories }"
          item="{ item }"
        ></catalog-element>
      </div>
    </div>
  </div>
  <script>
    import router from '../../scripts/router';
    import { matchSearch } from '../search-bar.riot';

    export default {
      onBeforeMount(props, state) {
        if (props.item.repositories && props.item.repositories.length === 1) {
          state.repository = props.item.repositories[0];
        } else if (typeof props.item === 'string') {
          state.repository = props.item;
        } else if (props.item.repositories && props.item.namespace) {
          state.repositories = props.item.repositories;
          state.namespace = props.item.namespace;
          state.expanded = props.catalogDefaultExpanded;
        }
        this.sync(props, state);
      },
      onBeforeUpdate(props, state) {
        this.sync(props, state);
      },
      sync(props, state) {
        if (props.showCatalogNbTags && state.repository) {
          state.nbTags = props.counts && props.counts[state.repository];
        }
        state.nRepositories = state.repositories ? this.countVisibleRepositories(state.repositories, props) : undefined;
      },
      // Images nest: CATALOG_MAX_BRANCHES > CATALOG_MIN_BRANCHES makes a group's
      // `repositories` holds sub-namespaces as well as repository names, so walk the tree. The
      // result drives both the badge and whether the group renders at all, so a
      // group whose images are all filtered out disappears with them instead of
      // sitting there empty with a count of hidden children.
      countVisibleRepositories(items, props) {
        return items.reduce((acc, item) => {
          if (typeof item === 'string') {
            return acc + (this.isRepositoryVisible(item, props) ? 1 : 0);
          }
          return acc + (item.repositories ? this.countVisibleRepositories(item.repositories, props) : 0);
        }, 0);
      },
      isRepositoryVisible(repository, props) {
        if (!matchSearch(props.filterResults, repository)) {
          return false;
        }
        if (!props.showCatalogNbTags || props.showTagless) {
          return true;
        }
        const nbTags = props.counts && props.counts[repository];
        return nbTags === null || nbTags > 0;
      },
      // With "show repositories without tags" off, only reveal a leaf once its count
      // is known to be non-zero. Treating a pending count as visible made every
      // tagless repository render and then vanish as the counts landed. Growing the
      // list is fine; removing rows after paint shifts the layout under the
      // user. A failed count (`null`) stays visible: we could not verify it is
      // tagless, so hiding it would be a guess.
      isRowVisible(props, state) {
        if (!props.showCatalogNbTags || props.showTagless) {
          return true;
        }
        if (state.repositories) {
          return state.nRepositories > 0;
        }
        return state.nbTags === null || state.nbTags > 0;
      },
      // `undefined` is still loading, `null` means the fetch failed.
      nbTagsLabel(nbTags) {
        if (nbTags === undefined) {
          return '…';
        }
        return nbTags === null ? '—' : nbTags;
      },
      nbTagsTitle(nbTags) {
        if (nbTags === undefined) {
          return 'Loading tag count…';
        }
        return nbTags === null ? 'Tag count unavailable' : nbTags + ' tags';
      },
      onClick() {
        const state = this.state;
        if (state.namespace) {
          this.update({
            expanded: !state.expanded,
          });
        }
      },
      matchSearch,
      router,
    };
  </script>
  <style>
    :host .tree-node {
      position: relative;
      content-visibility: auto;
      contain-intrinsic-size: auto 42px;
    }

    :host .list-row {
      cursor: default;
    }

    :host .list-row.is-group {
      cursor: pointer;
    }

    :host .row-main {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex: 1;
      min-width: 0;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      border-radius: var(--radius-sm);
      border: 0;
      background: transparent;
      padding: 0;
      text-align: left;
    }

    :host .row-main:hover {
      color: var(--accent);
    }

    :host .row-icon {
      font-size: 18px;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    :host .row-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: var(--font-mono);
      font-size: var(--fs-md);
    }

    :host .row-meta {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-left: auto;
      flex-shrink: 0;
    }

    :host .row-chevron {
      color: var(--text-muted);
      transition: transform var(--dur-normal) var(--ease-out);
    }

    :host .badge-icon {
      font-size: 14px;
    }

    :host .badge.is-pending {
      opacity: 0.7;
      min-width: 34px;
    }

    :host .badge.is-pending .badge-icon {
      opacity: 0.6;
    }

    :host .row-chevron.expanded {
      transform: rotate(180deg);
    }

    :host .tree-children {
      margin-left: var(--space-6);
      padding-left: var(--space-2);
      border-left: 1px solid var(--border);
    }

    :host .tree-children.collapsed {
      display: none;
    }

    @media screen and (max-width: 700px) {
      :host .tree-children {
        margin-left: var(--space-3);
        padding-left: var(--space-1);
      }
    }
  </style>
</catalog-element>
