<version-notification>
  <button
    if="{ state.tag_name && !isNewestVersion(props.version, state.tag_name) }"
    class="btn btn--icon btn--sm"
    onclick="{ onClick }"
    aria-label="A new version of Registry Explorer is available"
    title="A new version of Registry Explorer is available"
    type="button"
  >
    <span class="rocket"></span>
  </button>
  <app-dialog title="Check for updates" opened="{ state.open }" on-close="{ onClose }">
    <p>The version <b>{ state.tag_name }</b> of Registry Explorer is now available.</p>
    <p>You can download the latest version with docker.</p>
    <code class="pull-command">ghcr.io/yorch/docker-registry-ui:{ state.tag_name }</code>
    <div slot="footer">
      <button class="btn" onclick="{ onClose }" type="button">Close</button>
      <a
        class="btn btn--primary"
        href="{ releaseUrl() }"
        target="_blank"
        rel="noopener noreferrer"
      >
        Release Note
      </a>
    </div>
  </app-dialog>
  <script>
    import rocketIcon from '../images/rocket.svg';
    import { Http } from '../scripts/http';
    import { isNewestVersion, parseJSON, safeUrl } from '../scripts/utils';
    const LATEST = 'version-notification:latest';
    const EXPIRES = 'version-notification:expiration-date';
    const ONE_DAY = 24 * 60 * 60 * 1000;
    const ONE_WEEK = ONE_DAY * 7;
    export default {
      onMounted(props, state) {
        const latest = parseJSON(localStorage.getItem(LATEST));
        const expires = parseInt(localStorage.getItem(EXPIRES));
        if (latest && latest.tag_name) {
          this.update({ tag_name: latest.tag_name, latest });
        }
        if (isNaN(expires) || new Date().getTime() > expires) {
          this.checkForUpdates(props, state);
        }
      },
      onUpdated(props, state) {
        const rocket = this.$('.rocket');
        if (rocket) {
          rocket.innerHTML = rocketIcon().firstElementChild.outerHTML;
        }
      },
      onClose() {
        this.update({ open: false });
      },
      onClick() {
        this.update({ open: true });
      },
      checkForUpdates(props, state) {
        // noCache: the answer is stored in localStorage below, and a stale
        // cached one would hide a release. A 401 (rate limiting through a
        // proxy, say) is a failed check like any other HTTP failure.
        const oReq = new Http({ noCache: true, onAuthentication: () => failHttp(401, '') });
        const self = this;
        let aborted = false;

        // The check is only skipped for as long as the user is told: a week
        // after an answer, a day after a failure. Storage can be full or
        // blocked; that must never stop the user hearing about the failure.
        const remember = (retryAfter) => {
          try {
            localStorage.setItem(EXPIRES, new Date().getTime() + retryAfter);
          } catch (_e) {}
        };
        const failHttp = (status, body) => {
          remember(ONE_DAY);
          props.onNotify('Cannot check for new updates. Will try again in 24 hours. See the browser console.');

          console.error(
            `Cannot check for new Registry Explorer updates. This is most likely a GitHub issue. You don't need to worry about it.`
          );

          console.error(`Got status code ${status} from Github API with response ${body}`);
        };

        // The abort event comes just before loadend and only tells us the page
        // is going away; that must not postpone the next check.
        oReq.addEventListener('abort', () => {
          aborted = true;
        });

        // loadend, not load: it also fires for a 401 and for requests that
        // never got a response.
        oReq.addEventListener('loadend', function () {
          if (this.status === 0) {
            // Offline, air-gapped, CORS or blocked: expected on installs with
            // no route to GitHub, so retry in a day without a toast.
            if (!aborted) {
              remember(ONE_DAY);
              console.warn('Cannot reach the Github API to check for new Registry Explorer versions.');
            }
          } else if (this.status === 404) {
            // Should not notify if the project is not found.
            remember(ONE_WEEK);
          } else if (this.status === 200) {
            const latest = parseJSON(this.responseText);
            if (!latest || !latest.tag_name || typeof latest.tag_name !== 'string') {
              failHttp(200, this.responseText);
              return;
            }
            remember(ONE_WEEK);
            if (self.state.tag_name !== latest.tag_name && !isNewestVersion(props.version, latest.tag_name)) {
              props.onNotify('A new version of Registry Explorer is available!');
            }
            try {
              localStorage.setItem(LATEST, this.responseText);
            } catch (_e) {}
            self.update({ tag_name: latest.tag_name, latest });
          } else {
            failHttp(this.status, this.responseText);
          }
        });

        oReq.open('GET', 'https://api.github.com/repos/yorch/docker-registry-ui/releases/latest');
        oReq.send();
      },
      // The release page comes from the GitHub API response, cached in
      // localStorage, so it is only linked when it is an https URL.
      releaseUrl() {
        return safeUrl(this.state.latest?.html_url, ['https:']);
      },
      isNewestVersion,
    };
  </script>
  <style>
    :host .rocket {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    :host .rocket svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
    :host .pull-command {
      display: inline-block;
      background-color: var(--surface-muted);
      padding: 1px var(--space-2);
      border-radius: var(--radius-sm);
      font-size: var(--fs-md);
    }
    :host p b {
      color: var(--accent);
    }
  </style>
</version-notification>
