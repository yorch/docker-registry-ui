<app-dialog>
  <div if="{ props.opened }" class="dialog-overlay" onclick="{ props.onClose }"></div>
  <div
    if="{ props.opened }"
    class="dialog { props.wide ? 'dialog--wide' : '' }"
    role="dialog"
    aria-modal="true"
    aria-label="{ props.title }"
    tabindex="-1"
  >
    <div class="dialog-header">
      <h3>{ props.title }</h3>
      <button class="btn btn--icon" onclick="{ props.onClose }" aria-label="Close dialog" type="button">
        <i class="material-icons" aria-hidden="true">close</i>
      </button>
    </div>
    <div class="dialog-body"><slot /></div>
    <div class="dialog-footer"><slot name="footer" /></div>
  </div>
  <script>
    const FOCUSABLE =
      'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    // Every dialog in the app renders through this component, so modal
    // behaviour lives here once: Escape closes, focus moves in on open and is
    // trapped while open, and returns to whatever opened the dialog, or to the
    // element `return-focus` (a function) names when that opener is gone.
    export default {
      onBeforeUpdate(props) {
        // Still the opener at this point: the dialog has not rendered yet.
        if (props.opened && !this._open) {
          this._opener = document.activeElement;
        }
      },
      onMounted() {
        this.sync();
      },
      onUpdated() {
        this.sync();
      },
      onUnmounted() {
        this.stopListening();
      },
      sync() {
        const opened = !!this.props.opened;
        if (opened === !!this._open) {
          return;
        }
        this._open = opened;
        if (opened) {
          this._onKeyDown = (e) => this.onKeyDown(e);
          document.addEventListener('keydown', this._onKeyDown, true);
          this.focusIn();
        } else {
          this.stopListening();
          let target = this._opener;
          this._opener = null;
          // An opener that closed along with the dialog's launch (a popover
          // item) is gone; the caller can name something that still exists.
          if (!target?.isConnected && typeof this.props.returnFocus === 'function') {
            target = this.props.returnFocus();
          }
          if (target && target.isConnected && typeof target.focus === 'function') {
            target.focus();
          }
        }
      },
      stopListening() {
        if (this._onKeyDown) {
          document.removeEventListener('keydown', this._onKeyDown, true);
          this._onKeyDown = null;
        }
      },
      focusables() {
        const dialog = this.$('[role="dialog"]');
        return dialog ? [...dialog.querySelectorAll(FOCUSABLE)] : [];
      },
      // The first control in the body, so an input is ready to type in. When
      // the body has none (a confirmation), the dialog itself takes focus
      // rather than a destructive button.
      focusIn() {
        const dialog = this.$('[role="dialog"]');
        if (!dialog) {
          return;
        }
        const first = dialog.querySelector(`.dialog-body :is(${FOCUSABLE})`);
        (first || dialog).focus();
      },
      onKeyDown(e) {
        if (e.key === 'Escape') {
          e.preventDefault();
          e.stopPropagation();
          if (this.props.onClose) {
            this.props.onClose();
          }
          return;
        }
        if (e.key !== 'Tab') {
          return;
        }
        const dialog = this.$('[role="dialog"]');
        const items = this.focusables();
        if (!dialog || items.length === 0) {
          e.preventDefault();
          return;
        }
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (!dialog.contains(active) || active === dialog) {
          e.preventDefault();
          (e.shiftKey ? last : first).focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      },
    };
  </script>
</app-dialog>
