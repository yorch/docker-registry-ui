<tag-list>
  <div class="panel" aria-busy="{ !state.loadend || state.refreshing ? 'true' : 'false' }">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">
          Tags
          <span class="panel-subtitle">of { props.image }</span>
        </h2>
        <!-- The host, not REGISTRY_TITLE: this has to read as a pullable reference. -->
        <p class="source-hint">Sourced from { stripHttps(props.registryUrl) + '/' + props.image }</p>
      </div>
      <div class="tag-actions">
        <span if="{ state.loadend }" class="badge badge--accent">
          { props.filterResults ? filteredTags().length + ' of ' + state.tags.length : state.tags.length } tags
        </span>
        <button
          class="btn btn--sm"
          onclick="{ refresh }"
          disabled="{ !state.loadend || state.refreshing }"
          aria-label="Refresh tags"
          type="button"
        >
          <i class="material-icons" aria-hidden="true">refresh</i>
          { state.refreshing ? 'Refreshing…' : 'Refresh' }
        </button>
      </div>
    </div>
  </div>

  <div class="panel" if="{ !state.loadend }" role="status" aria-label="Loading tags">
    <div class="skeleton-row" each="{ i in skeletonRows }">
      <span aria-hidden="true" class="skeleton skeleton-line { i % 3 === 0 ? 'wide' : '' }"></span>
      <span aria-hidden="true" class="skeleton skeleton-line short"></span>
    </div>
    <span class="sr-only">Loading tags…</span>
  </div>

  <p if="{ state.refreshing }" class="refresh-status" role="status">Refreshing tags…</p>

  <div if="{ state.loadend && !hasVisibleTags() }" class="empty-state">
    <span class="empty-icon"><i class="material-icons" aria-hidden="true">search_off</i></span>
    <h3>{ props.filterResults ? 'No matching tags' : 'No tags' }</h3>
    <p if="{ props.filterResults }">No tag matches “{ props.filterResults }”.</p>
    <p if="{ !props.filterResults }">This repository has no tags yet.</p>
    <button if="{ props.filterResults }" class="btn" onclick="{ props.onClearSearch }" type="button">Clear Search</button>
  </div>

  <div class="table-wrap" if="{ state.loadend && hasVisibleTags() }">
    <tag-table
      tags="{ filteredTags() }"
      all-tags="{ state.tags }"
      asc="{state.asc}"
      page="{ state.page }"
      show-content-digest="{props.showContentDigest}"
      show-tag-history="{props.showTagHistory}"
      is-image-remove-activated="{props.isImageRemoveActivated}"
      onReverseOrder="{ onReverseOrder }"
      registry-url="{ props.registryUrl }"
      pull-url="{ props.pullUrl }"
      on-notify="{ props.onNotify }"
      filter-results=""
      on-authentication="{ props.onAuthentication }"
      tags-per-page="{ props.tagsPerPage }"
      is-registry-secured="{ props.isRegistrySecured }"
      on-image-deleted="{ () => state.reload() }"
    ></tag-table>
  </div>

  <pagination if="{ state.loadend && hasVisibleTags() && getNumPages(filteredTags(), props.tagsPerPage) > 1 }"
    pages="{ getPageLabels(state.page, getNumPages(filteredTags(), props.tagsPerPage)) }"
    onPageUpdate="{onPageUpdate}"
  ></pagination>

  <script>
    import { Http } from '../../scripts/http';
    import { DockerImage } from '../../scripts/docker-image';
    import { getNumPages, getPageLabels, stripHttps } from '../../scripts/utils';
    import { matchSearch } from '../search-bar.riot';
    import Pagination from './pagination.riot';
    import TagTable from './tag-table.riot';
    import router from '../../scripts/router';
    import { getTagComparator, taglistOrderParser } from '../../scripts/taglist-order';
    import { invalidateRepository } from '../../scripts/cache-request';
    import { requestPool } from '../../scripts/request-pool';

    export default {
      components: {
        Pagination,
        TagTable,
      },
      skeletonRows: [0, 1, 2, 3, 4, 5, 6, 7],
      onBeforeMount(props) {
        this.state = {
          tags: [],
          loadend: false,
          asc: true,
          page: router.getPageQueryParam() || 1,
          loadedFilter: props.filterResults,
        };
        try {
          this.state.taglistOrder = taglistOrderParser(props.taglistOrder);
        } catch (e) {
          props.onNotify(e);
        }
      },
      onMounted(props, state) {
        this.display(props, state);
        window.addEventListener('resize', this.onResize);
        // this may be run before the final document size is available, so schedule
        //  a correction once everything is set up.
        window.requestAnimationFrame(this.onResize);
        this.tagComparator = getTagComparator(props.taglistOrder);
      },
      // Both repositories match the same route, so the router keeps this
      // component mounted and swaps `image` rather than remounting. Fetching
      // only on mount left the previous repository's tags on screen under the
      // new repository's name.
      onUpdated(props, state) {
        if (props.image !== state.loadedImage) {
          this.display(props, state);
        } else if (props.filterResults !== state.loadedFilter) {
          state.loadedFilter = props.filterResults;
          if (state.page !== 1) {
            this.update({ page: 1 });
            router.updatePageQueryParam(1);
          }
        }
      },
      onBeforeUnmount() {
        this.activeRequest?.abort();
        requestPool.drop();
        this.requestGeneration = (this.requestGeneration || 0) + 1;
      },
      refresh() {
        this.display(this.props, this.state, true);
      },
      display(props, state, refresh = false) {
        // Claimed before anything can trigger a render, so the update() calls
        // below cannot re-enter through onUpdated and start a second request.
        state.loadedImage = props.image;
        // Read from `this` rather than the captured arguments: by the time a
        // reload fires, the component may have moved on to another repository.
        state.reload = () => this.display(this.props, this.state, true);
        const generation = (this.requestGeneration || 0) + 1;
        this.requestGeneration = generation;
        this.activeRequest?.abort();
        if (refresh) {
          invalidateRepository(props.registryUrl, props.image);
          this.update({ refreshing: true });
        } else {
          state.loadend = false;
        }
        state.page = router.getPageQueryParam() || 1;
        if (!refresh) state.tags = [];
        const self = this;
        const oReq = new Http({
          onAuthentication: props.onAuthentication,
          withCredentials: props.isRegistrySecured,
          noCache: refresh,
        });
        oReq.addEventListener('load', function () {
          if (generation !== self.requestGeneration) return;
          if (this.status === 200) {
            const tags = (JSON.parse(this.responseText).tags || [])
              .map(
                (tag) =>
                  new DockerImage(props.image, tag, {
                    list: true,
                    registryUrl: props.registryUrl,
                    onNotify: props.onNotify,
                    onAuthentication: props.onAuthentication,
                    useControlCacheHeader: props.useControlCacheHeader,
                    isRegistrySecured: props.isRegistrySecured,
                  })
              )
              .sort(self.tagComparator);
            window.requestAnimationFrame(self.onResize);
            self.update({
              page: Math.min(state.page, getNumPages(tags, props.tagsPerPage)),
              tags,
            });
          } else if (this.status === 404) {
            self.props.onNotify('Server not found', true);
          } else {
            self.props.onNotify(this.responseText, true);
          }
        });
        oReq.addEventListener('error', function () {
          if (generation !== self.requestGeneration) return;
          self.props.onNotify(this.getErrorMessage(), true);
          state.tags = [];
        });
        oReq.addEventListener('loadend', function () {
          if (generation !== self.requestGeneration) return;
          self.update({
            loadend: true,
            refreshing: false,
          });
        });
        oReq.open('GET', props.registryUrl + '/v2/' + props.image + '/tags/list');
        this.activeRequest = oReq;
        oReq.send();
        state.asc = true;
      },

      onPageUpdate(idx) {
        const labels = getPageLabels(this.state.page, getNumPages(this.filteredTags(), this.props.tagsPerPage));
        const page = labels[idx].page;
        this.update({
          page: page,
        });
        router.updatePageQueryParam(page);
      },

      onResize() {
        // window.innerWidth is a blocking access, cache its result.
        const innerWidth = window.innerWidth;
        let chars = 0;
        const max = this.state.tags.reduce(function (acc, e) {
          return e.tag.length > acc ? e.tag.length : acc;
        }, 0);
        if (innerWidth >= 1440) {
          chars = 71;
        } else if (innerWidth < 1024) {
          chars = 0;
        } else {
          // SHA256:12345678 + scaled between 1024 and 1440px
          chars = 15 + 56 * ((innerWidth - 1024) / 416);
        }
        if (max > 20) chars -= max - 20;
        chars = Math.floor(chars);
        this.state.tags.map(function (image) {
          image.trigger('content-digest-chars', chars);
        });
      },

      onReverseOrder() {
        if (this.state.asc) {
          this.state.tags.reverse();
          this.state.asc = false;
        } else {
          this.state.tags.sort(this.tagComparator);
          this.state.asc = true;
        }
        this.update();
      },
      hasVisibleTags() {
        return this.filteredTags().length > 0;
      },
      filteredTags() {
        return this.state.tags.filter((image) => matchSearch(this.props.filterResults, image.tag));
      },
      getPageLabels,
      getNumPages,
      // Template expressions resolve against the component, not module scope.
      stripHttps,
      router,
    };
  </script>
  <style>
    :host .source-hint {
      margin: var(--space-1) 0 0;
      font-size: var(--fs-md);
      color: var(--text-muted);
    }

    :host .table-wrap {
      margin-top: var(--space-4);
    }

    :host .tag-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
  </style>
</tag-list>
