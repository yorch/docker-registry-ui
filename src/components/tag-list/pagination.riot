<pagination>
  <nav class="pagination" aria-label="Pagination">
    <button
      each="{ (p, idx) in props.pages }"
      class="btn btn--sm { p.current ? 'is-current' : '' }"
      onclick="{(e) => props.onPageUpdate(idx)}"
      aria-label="{ pageLabel(p) }"
      aria-current="{ p.current ? 'page' : null }"
      type="button"
    >
      <i if="{ p.icon }" class="material-icons" aria-hidden="true">{ p.icon }</i>
      <template if="{ !p.icon }">{ p.page }</template>
    </button>
  </nav>
  <script>
    const ICON_LABELS = {
      first_page: 'First page',
      chevron_left: 'Previous page',
      chevron_right: 'Next page',
      last_page: 'Last page',
    };

    export default {
      pageLabel(p) {
        return ICON_LABELS[p.icon] || `Page ${p.page}`;
      },
    };
  </script>
  <style>
    :host .pagination {
      display: flex;
      justify-content: center;
      gap: 2px;
      flex-wrap: wrap;
      margin: var(--space-4) 0;
    }

    :host .btn.is-current {
      background-color: var(--accent-soft);
      color: var(--accent);
    }

    :host .btn.is-current:hover {
      background-color: var(--accent-soft-hover);
    }

    :host .btn .material-icons {
      font-size: 18px;
    }
  </style>
</pagination>
