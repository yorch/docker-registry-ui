<architectures>
  <div if="{ !state.architectures }" class="placeholder" title="{ placeholderTitle(state) }">
    { placeholder(state) }
  </div>
  <div class="architecture" each="{ architecture in state.architectures }">{ architecture }</div>
  <script>
    import { platformToString } from '../../scripts/docker-image';
    import { PENDING_LABEL, UNAVAILABLE_LABEL } from '../../scripts/utils';
    export default {
      placeholder(state) {
        return state.failed ? UNAVAILABLE_LABEL : PENDING_LABEL;
      },
      placeholderTitle(state) {
        return state.failed ? 'Architecture unavailable' : 'Loading architecture…';
      },
      onMounted(props, state) {
        this.onLoad(props, state);
      },
      onUpdated(props, state) {
        if (props.image !== state.image) {
          this.onLoad(props, state);
        }
      },
      onLoad(props, state) {
        if (props.image.manifests) {
          return this.onList(props.image.manifests, props, state);
        } else if (props.image.blobs) {
          return this.onBlobs(props.image.blobs, props, state);
        }
        // state.image is only assigned once a response lands, so the onUpdated
        // guard above does not hold while the manifest is in flight and every
        // re-render used to add another pair of listeners. Track the
        // subscription separately so it happens once per image.
        if (state.subscribedTo === props.image) {
          return;
        }
        state.subscribedTo = props.image;
        props.image.on('blobs', (blobs) => this.onBlobs(blobs, props, state));
        props.image.on('list', (list) => this.onList(list, props, state));
      },
      onBlobs(blobs, props, state) {
        // platformToString(null) answers 'unknown', which would read as a real
        // architecture rather than as a fetch that failed.
        if (!blobs) {
          return this.update({ architectures: undefined, failed: true, image: props.image });
        }
        const architectures = [platformToString(blobs)];
        if (!props.image.manifests) {
          this.update({ architectures, image: props.image });
        }
      },
      onList(list, props, state) {
        if (!list) {
          return this.update({ architectures: undefined, failed: true, image: props.image });
        }
        const architectures = list.map(({ platform }) => platformToString(platform));
        this.update({ architectures, image: props.image });
      },
    };
  </script>
  <style>
    :host {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }
    :host .architecture {
      background-color: var(--surface-muted);
      color: var(--text-secondary);
      padding: 2px var(--space-2);
      border-radius: var(--radius-full);
      text-align: center;
      font-size: var(--fs-sm);
      font-weight: 500;
      line-height: var(--lh-tight);
      white-space: nowrap;
    }
  </style>
</architectures>
