<confirm-delete-image>
  <app-dialog title="These images will be deleted" opened="{ props.opened }" on-close="{ close }">
    <ul class="delete-list">
      <li each="{ image in displayImagesToDelete(props.toDelete, props.tags) }">{ image.name }:{ image.tag }</li>
    </ul>
    <p class="warning">
      Deleting one tag removes every tag sharing the same manifest (SHA). Run
      <code>registry garbage-collect config.yml</code> on your registry to free the storage.
    </p>
    <p class="progress" if="{ state.progress }" role="status">
      Checking tags { state.progress.done }/{ state.progress.total }
    </p>
    <div slot="footer">
      <button class="btn" onclick="{ close }" disabled="{ state.deleting }" type="button">Cancel</button>
      <button class="btn btn--danger" onclick="{ deleteImages }" disabled="{ state.deleting }" type="button">
        { state.deleting ? 'Deleting…' : 'Delete' }
      </button>
    </div>
  </app-dialog>
  <script>
    import { invalidateRepository } from '../../scripts/cache-request';
    import { RegistryClient } from '../../scripts/registry-client';
    import { ERROR_CAN_NOT_READ_CONTENT_DIGEST } from '../../scripts/utils';

    const sameTags = (left, right) => {
      const a = [...left].sort();
      const b = [...right].sort();
      return a.length === b.length && a.every((tag, index) => tag === b[index]);
    };

    export default {
      displayImagesToDelete(toDelete, tags) {
        const contentDigests = new Set();
        toDelete.forEach((image) => {
          if (image.contentDigest) {
            contentDigests.add(image.contentDigest);
          }
        });
        return tags.filter((image) => contentDigests.has(image.contentDigest));
      },
      close() {
        if (!this.state.deleting) this.props.onClick();
      },
      /*
       * The dialog lists sibling tags from digests cached when the tag list
       * loaded, but a DELETE removes whatever the registry resolves the digest
       * to now. So before anything is deleted every selected tag's digest is
       * re-read past the cache, and the tags now sharing it are re-listed; if
       * either differs from what was shown, nothing is deleted. Aliases of one
       * digest are then deleted with a single request: a second DELETE of an
       * already-removed manifest would report a false "not found".
       */
      async deleteImages() {
        if (this.state.deleting) return;
        this.update({ deleting: true });
        const { onNotify, onImageDeleted, onClick } = this.props;
        try {
          const selected = Array.from(this.props.toDelete);
          const plan = await this.planDeletes(selected);
          if (!plan) return;
          const results = [];
          for (const entry of plan) {
            results.push(await this.deleteDigest(entry));
          }
          results.forEach((deleted, index) => {
            if (deleted) {
              plan[index].images.forEach((image) => this.props.toDelete.delete(image));
            }
          });
          if (results.some(Boolean)) {
            await onImageDeleted();
          }
        } catch (error) {
          onNotify(`Could not delete: ${error?.message || error}`, true);
        } finally {
          this.update({ deleting: false });
          onClick();
        }
      },
      // Resolves the selection to one entry per distinct { repository, digest },
      // or notifies and returns undefined when it cannot be verified.
      async planDeletes(selected) {
        const { registryUrl, onNotify, onAuthentication, isRegistrySecured, tags } = this.props;
        const client = new RegistryClient({ registryUrl, onAuthentication, isRegistrySecured });
        const groups = new Map();
        const fresh = await Promise.allSettled(
          selected.map((image) => client.manifest(image.name, image.tag, { noCache: true })),
        );
        for (const [index, result] of fresh.entries()) {
          const { name, tag, contentDigest } = selected[index];
          if (result.status !== 'fulfilled') {
            const error = result.reason;
            onNotify(
              error?.status === 404
                ? `Manifest for ${name}:${tag} not found`
                : `Could not read ${name}:${tag}: ${error?.message || error}`,
              true,
            );
            return undefined;
          }
          const digest = result.value.digest;
          if (!digest) {
            onNotify(ERROR_CAN_NOT_READ_CONTENT_DIGEST, true);
            return undefined;
          }
          if (digest !== contentDigest) {
            onNotify(`${name}:${tag} changed since this list loaded; nothing was deleted. Refresh and try again.`, true);
            return undefined;
          }
          const key = `${name}@${digest}`;
          const group = groups.get(key) || { name, digest, images: [] };
          group.images.push(selected[index]);
          groups.set(key, group);
        }
        const plan = [...groups.values()];
        const repositories = [...new Set(plan.map((entry) => entry.name))];
        // One repository at a time would hide the others' progress; show the sum.
        const counts = new Map();
        const onProgress = (name) => (progress) => {
          counts.set(name, progress);
          const values = [...counts.values()];
          this.update({
            progress: {
              done: values.reduce((sum, value) => sum + value.done, 0),
              total: values.reduce((sum, value) => sum + value.total, 0),
            },
          });
        };
        const aliasMaps = await Promise.allSettled(
          repositories.map((name) => client.currentAliases(name, { onProgress: onProgress(name) })),
        );
        this.update({ progress: undefined });
        for (const [index, result] of aliasMaps.entries()) {
          if (result.status !== 'fulfilled') {
            onNotify(result.reason?.message || String(result.reason), true);
            return undefined;
          }
          for (const entry of plan.filter((candidate) => candidate.name === repositories[index])) {
            const parents = result.value.referenced.get(entry.digest) || [];
            if (parents.length) {
              const label = `${entry.name}:${entry.images[0].tag}`;
              const list = parents.map((parent) => `${entry.name}:${parent}`).join(', ');
              // Only point at the index when the user chose it; otherwise deleting it
              // would be advice to break every platform of an image they kept.
              const selectedParents = parents.filter((parent) =>
                selected.some((image) => image.name === entry.name && image.tag === parent),
              );
              onNotify(
                selectedParents.length
                  ? `${label} is referenced by index ${parents.join(', ')}; nothing was deleted. Delete the index first.`
                  : `${label} is part of index ${list}; nothing was deleted, and deleting it would break that index.`,
                true,
              );
              return undefined;
            }
            const current = result.value.aliases.get(entry.digest) || [];
            const shown = tags.filter((t) => t.name === entry.name && t.contentDigest === entry.digest).map((t) => t.tag);
            if (!sameTags(current, shown)) {
              onNotify('Tags changed since this dialog was opened; nothing was deleted. Refresh and try again.', true);
              return undefined;
            }
          }
        }
        return plan;
      },
      // Residual race, unavoidable: a tag can still be pushed between the final
      // alias check in planDeletes and this DELETE, and the registry API has no
      // conditional (compare-and-delete) form to close it.
      async deleteDigest({ name, digest, images }) {
        const { registryUrl, ignoreError, onNotify, onAuthentication, isRegistrySecured } = this.props;
        const client = new RegistryClient({ registryUrl, onAuthentication, isRegistrySecured });
        try {
          await client.deleteManifest(name, digest);
        } catch (error) {
          if (error.status === 404) {
            ignoreError || onNotify('Digest not found for this image in your registry.', true);
          } else if (error.status) {
            onNotify(`Could not delete ${name}: ${error.message}`, true);
          } else {
            const credMsg = isRegistrySecured
              ? ' When you use credentials on a different hostname, the registry server may fail preflight requests. Check FAQ and issue #104.'
              : '';
            onNotify(
              "An error occurred when deleting image. Check if your server accept DELETE methods Access-Control-Allow-Methods: ['DELETE']." +
                credMsg,
              true,
            );
          }
          return false;
        }
        invalidateRepository(registryUrl, name);
        const label = images.map((image) => `${name}:${image.tag}`).join(', ');
        onNotify(`Deleted ${label}. Run \`registry garbage-collect config.yml\` on your registry`);
        return true;
      },
    };
  </script>
  <style>
    :host .delete-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      max-height: 240px;
      overflow-y: auto;
      font-family: var(--font-mono);
      font-size: var(--fs-md);
    }

    :host .warning {
      color: var(--text-secondary);
      font-size: var(--fs-md);
      margin: var(--space-4) 0 0;
    }

    :host .progress {
      color: var(--text-secondary);
      font-size: var(--fs-md);
      margin: var(--space-2) 0 0;
    }

    :host .warning code {
      background-color: var(--surface-muted);
      padding: 1px var(--space-1);
      border-radius: var(--radius-sm);
      font-size: var(--fs-sm);
    }
  </style>
</confirm-delete-image>
