<confirm-delete-image>
  <app-dialog title="These images will be deleted" opened="{ props.opened }" on-close="{ close }">
    <ul class="delete-list">
      <li each="{ image in displayImagesToDelete(props.toDelete, props.tags) }">{ image.name }:{ image.tag }</li>
    </ul>
    <p class="warning">
      Deleting one tag removes every tag sharing the same manifest (SHA). Run
      <code>registry garbage-collect config.yml</code> on your registry to free the storage.
    </p>
    <div slot="footer">
      <button class="btn" onclick="{ close }" disabled="{ state.deleting }" type="button">Cancel</button>
      <button class="btn btn--danger" onclick="{ deleteImages }" disabled="{ state.deleting }" type="button">
        { state.deleting ? 'Deleting…' : 'Delete' }
      </button>
    </div>
  </app-dialog>
  <script>
    import { Http } from '../../scripts/http';
    import { invalidateRepository } from '../../scripts/cache-request';
    import { ERROR_CAN_NOT_READ_CONTENT_DIGEST } from '../../scripts/utils';
    export default {
      displayImagesToDelete(toDelete, tags) {
        const contentDigests = new Set();
        toDelete.forEach((image) => {
          if (image.contentDigest) {
            contentDigests.add(image.contentDigest);
          }
        });
        return tags.filter((image) => contentDigests.has(image.contentDigest));
      },
      close() {
        if (!this.state.deleting) this.props.onClick();
      },
      async deleteImages() {
        if (this.state.deleting) return;
        this.update({ deleting: true });
        const selected = Array.from(this.props.toDelete);
        const results = await Promise.all(selected.map((image) => this.getContentDigestThenDelete(image, this.props)));
        results.forEach((deleted, index) => {
          if (deleted) {
            const digest = selected[index].contentDigest;
            selected.filter((image) => image.contentDigest === digest).forEach((image) => this.props.toDelete.delete(image));
          }
        });
        if (results.some(Boolean)) {
          await this.props.onImageDeleted();
        }
        this.update({ deleting: false });
        this.props.onClick();
      },
      getContentDigestThenDelete({ name, tag }, opts) {
        return new Promise((resolve) => {
          const { registryUrl, onNotify, onAuthentication, isRegistrySecured } = opts;
          // Reads the digest this image is about to be deleted by, so it has to
          // see the registry as it is now: a cached digest from before a re-push
          // would delete the previous manifest and leave the current one.
          const oReq = new Http({ onAuthentication, withCredentials: isRegistrySecured, noCache: true });
          const self = this;
          oReq.addEventListener('loadend', function () {
            if (this.status === 200 || this.status === 202) {
              oReq.getContentDigest(function (contentDigest) {
                if (!contentDigest) {
                  onNotify(ERROR_CAN_NOT_READ_CONTENT_DIGEST);
                  resolve(false);
                } else {
                  self.deleteImage({ name, tag, contentDigest }, opts).then(resolve);
                }
              });
            } else if (this.status === 404) {
              onNotify(`Manifest for ${name}:${tag} not found`, true);
              resolve(false);
            } else {
              onNotify(this.responseText);
              resolve(false);
            }
          });
          oReq.open('GET', `${registryUrl}/v2/${name}/manifests/${tag}`);
          oReq.setRequestHeader(
            'Accept',
            'application/vnd.docker.distribution.manifest.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.index.v1+json',
          );
          oReq.send();
        });
      },
      deleteImage({ name, tag, contentDigest }, opts) {
        return new Promise((resolve) => {
          const { registryUrl, ignoreError, onNotify, onAuthentication, isRegistrySecured } = opts;
          const oReq = new Http({ onAuthentication, withCredentials: isRegistrySecured });
          oReq.addEventListener('loadend', function () {
            if (this.status === 200 || this.status === 202) {
              invalidateRepository(registryUrl, name);
              onNotify(`Deleted ${name}:${tag}. Run \`registry garbage-collect config.yml\` on your registry`);
              resolve(true);
            } else if (this.status === 404) {
              ignoreError ||
                onNotify({
                  message: 'Digest not found for this image in your registry.',
                  isError: true,
                });
              resolve(false);
            } else {
              onNotify(this.responseText);
              resolve(false);
            }
          });
          oReq.open('DELETE', `${registryUrl}/v2/${name}/manifests/${contentDigest}`);
          oReq.setRequestHeader(
            'Accept',
            'application/vnd.docker.distribution.manifest.v2+json, application/vnd.oci.image.manifest.v1+json',
          );
          oReq.addEventListener('error', function () {
            const credMsg = this.withCredentials
              ? ' When you use credentials on a different hostname, the registry server may fail preflight requests. Check FAQ and issue #104.'
              : '';
            onNotify({
              message:
                "An error occurred when deleting image. Check if your server accept DELETE methods Access-Control-Allow-Methods: ['DELETE']." +
                credMsg,
              isError: true,
            });
            resolve(false);
          });
          oReq.send();
        });
      },
    };
  </script>
  <style>
    :host .delete-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      max-height: 240px;
      overflow-y: auto;
      font-family: var(--font-mono);
      font-size: var(--fs-md);
    }

    :host .warning {
      color: var(--text-secondary);
      font-size: var(--fs-md);
      margin: var(--space-4) 0 0;
    }

    :host .warning code {
      background-color: var(--surface-muted);
      padding: 1px var(--space-1);
      border-radius: var(--radius-sm);
      font-size: var(--fs-sm);
    }
  </style>
</confirm-delete-image>
